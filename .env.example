# Copia como .env (está en .gitignore). Nunca subas valores reales.
APP_PROFILE=dev                 # dev | demo | prod
EARTHDATA_TOKEN=                # urs.earthdata.nasa.gov -> Generate Token
FIRMS_MAP_KEY=                  # opcional, capa complementaria de incendios
GAIA_REPORTS_ADMIN_TOKEN=        # solo servidor, moderación de reportes ciudadanos
GOOGLE_MAPS_KEY=                 # solo servidor y opcional, metadatos de Street View
GAIA_COMMERCIAL=0                # 1 desactiva fotos de informes con licencia no comercial
ANALYST_API_KEY=                # opcional (fase P1), solo servidor
ANALYST_MODEL=                  # confirma el nombre vigente en la documentación de Anthropic
DATA_DIR=./data
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
